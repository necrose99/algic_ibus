{
	"folders": [
		{
			"name": "Algic Input Matrix Development",
			"path": "."
		}
	],
	"settings": {
		// --- File Associations & Syntaxes ---
		"files.associations": {
			"*.in": "properties",        // Maps _inputrc.in with clean key/value highlighting
			"algic_keys.txt": "tsv"       // Treats your data lookup matrix text table as TSV
		},

		// --- Whitespace & Tab Alignment Hygiene ---
		// This protects against breaking 'ibus-table-createdb' parser loops with literal spaces
		"[tsv]": {
			"editor.insertSpaces": false,
			"editor.tabSize": 8,
			"editor.trimTrailingWhitespace": true
		},
		"[properties]": {
			"editor.insertSpaces": false,
			"editor.tabSize": 4
		},
		"[shellscript]": {
			"editor.tabSize": 4,
			"editor.insertSpaces": true
		},

		// --- Build/Output Exclusions ---
		// Hides compiled binary blobs from bloating global fuzzy search buffers
		"search.exclude": {
			"**/*.db": true,
			"build_output/": true,
			"algic_ibus-linux-generic/": true
		},
		"files.watcherExclude": {
			"**/*.db": true,
			"build_output/": true
		}
	}
}
