# Algic Language Keystroke Mapping Matrix

# Core Diacritics (Myaamia / Potawatomi)
"\es": "š"
"\ez": "ž"
"\ec": "č"
"\ea": "ā"
"\ee": "ē"
"\ei": "ī"
"\eo": "ō"
"'e": "é"
"'E": "É"

# Proto-Algonquian & Central Dialect Extensions
"\el": "ɬ"  # Alt + l -> Voiceless lateral fricative (Proto-Algonquian)
"\eL": "Ł"  # Alt + Shift + l 
"\et": "θ"  # Alt + t -> Theta (Shawnee / Sauk)
"\eq": "ʔ"  # Alt + q -> Glottal Stop

# California Isolates Extensions (Yurok / Wiyot)
"\eg": "ɣ"  # Alt + g -> Gamma/Fricative g
